rules_version = '2';
// Paste into Firebase console -> Firestore Database -> Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per table, named by its 5-character code.
    match /games/{code} {
      allow read: if request.auth != null;
      // Create: you must be the host, the code must look right, and the record must stay small.
      allow create: if request.auth != null
        && code.matches('^[A-Z0-9]{5}$')
        && request.resource.data.host == request.auth.uid
        && request.resource.data.size() < 40;
      // Change: the host, anyone already seated, or anyone taking a seat while the table is still in the lobby.
      allow update: if request.auth != null
        && request.resource.data.size() < 40
        && (resource.data.host == request.auth.uid
            || request.auth.uid in resource.data.get('players', [])
            || resource.data.status == 'lobby');
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
    }
    // Emoji reactions: one tiny document per table, overwritten on every reaction.
    match /reacts/{room} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['e','s','by','at','n'])
        && request.resource.data.by == request.auth.uid;
    }
  }
}
